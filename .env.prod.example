# Copy to `.env` on your production host and fill values.
# Used by: docker-compose.prod.build.yml

# --- Frontend build-time ---
# Fixed subpath deployment (trailing slash required by Vite):
VITE_BASE=/hivecards-manager/

# --- App runtime ---
# Include subpath so links in mails point to the routed frontend.
APP_URL=https://olli-home.duckdns.org/hivecards-manager
# Must match VITE_BASE without trailing slash.
SERVE_ROOT=/hivecards-manager
# For same-origin setup with reverse proxy this should be your public origin.
CORS_ORIGIN=https://olli-home.duckdns.org
LOG_LEVEL=INFO

# --- Database ---
MONGODB_URI=mongodb://192.168.178.117:27017/hivecards

# --- Auth ---
# IMPORTANT: set a long random secret
JWT_SECRET=replace_with_a_long_random_secret
# true when public URL is HTTPS
COOKIE_SECURE=true

# --- Mail (SMTP) ---
MAIL_HOST=mail.your-server.de
MAIL_PORT=587
MAIL_SECURE=false
MAIL_FROM=Hivecards <hivecards@teckbiene.de>
MAIL_USER=hivecards@teckbiene.de
MAIL_PASS=replace_with_real_password
