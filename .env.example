MONGODB_URI=mongodb://localhost:27017/hivecards
JWT_SECRET=replace_with_a_strong_secret
PORT=3000

# Production: comma-separated list of allowed CORS origins
# Leave empty to use localhost defaults (dev mode)
# Example: CORS_ORIGIN=https://hivecards.example.com
CORS_ORIGIN=

# Subpath at which the app is served (must match nginx location and VITE_BASE in frontend/.env.production)
# Leave empty or set to / for root-path deployments
# Example: SERVE_ROOT=/hivecards-manager
SERVE_ROOT=/hivecards-manager
